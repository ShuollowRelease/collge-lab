{
  "name": "glow-collage",
  "version": "1.0.0",
  "description": "光房拼贴 — 照片拼贴工具",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
