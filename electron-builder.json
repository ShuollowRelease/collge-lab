{
  "appId": "com.photo.cut",
  "productName": "photo-cut",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "icon/**/*"
  ],
  "win": {
    "target": "nsis",
    "icon": "icon/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
